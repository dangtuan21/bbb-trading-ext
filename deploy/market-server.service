[Unit]
Description=bbb-trading-ext FX market data server (market-server)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/bbb-trading-ext/market-server
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/bbb-trading-ext/market-server.log
StandardError=append:/var/log/bbb-trading-ext/market-server.log

[Install]
WantedBy=multi-user.target
