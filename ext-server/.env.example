# Copy this file to .env (gitignored) and fill in your own values.
# PUSHOVER_USER_KEY: from your Pushover account page (pushover.net).
# PUSHOVER_API_TOKEN: create an "Application" at pushover.net/apps/build and
# use the API Token/Key it gives you -- required alongside the user key
# above for the warning -> phone-notification feature (see server.js).
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
