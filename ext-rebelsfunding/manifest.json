{
  "manifest_version": 3,
  "name": "RebelsFunding Positions Tracker",
  "version": "1.0.0",
  "description": "Scans every active RebelsFunding account (Challenge + Funded) via RF Client Zone and RF-Trader, and writes the results to a local CSV file.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://rf-zone.rebelsfunding.com/*",
    "https://*.rf-trader.com/*",
    "https://moreleadnow.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "RebelsFunding Positions Tracker"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
