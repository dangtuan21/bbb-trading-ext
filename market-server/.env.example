# Copy this file to .env (gitignored) and fill in your own value.
# TWELVEDATA_API_KEY: from your TwelveData account -- sign up at
# twelvedata.com, the free tier (800 requests/day, 8 API credits/minute).
# Confirmed against a real response on 2026-09-01: TwelveData charges 1
# credit per symbol even inside one batched /price request, so
# config.json's default 9-pair list would exceed the 8/minute cap in a
# single call -- server.js's fetchRatesChunked() splits pairs into chunks
# of at most 8 and spaces chunks about a minute apart to stay under that
# limit, so no config change is needed here for the default pair list.
TWELVEDATA_API_KEY=
