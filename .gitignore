# OS
.DS_Store

# Dependencies
node_modules/

# Runtime data written by the extensions/server -- contains real account
# balances, equity, and open positions, not just sample data.
ext-server/*.csv
trading-console/public/data/*.csv
trading-console/public/data/positions.csv
trading-console/public/data/config.json

# Runtime data written by market-server (see market-server/server.js) --
# live FX rates, refreshed every config.json-defined interval. Mirrored copy
# under trading-console/public/data/ is already covered by the *.csv
# wildcard above.
market-server/*.csv

# TwelveData API key -- see ENV_FILE in market-server/server.js. Copy
# market-server/.env.example (checked in) to market-server/.env and fill in
# TWELVEDATA_API_KEY; .env itself never lands in git.
market-server/.env

# Pushover credentials for the warning -> phone-notification feature -- see
# ENV_FILE in ext-server/server.js. Copy ext-server/.env.example (checked
# in) to ext-server/.env and fill in real values; .env itself never lands
# in git.
ext-server/.env

# Local tuning (thresholds, which alerts are on) for the same feature --
# no secrets in here anymore (see ext-server/.env above), just a personal
# preference file kept out of git the same way trading-console's warning
# thresholds (localStorage) aren't checked in either.
ext-server/notify-config.json

# Logs
*.log
npm-debug.log*

# Build output
trading-console/dist/

# Editor
.vscode/
.idea/
